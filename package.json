{
  "name": "threadline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Threadline \u2014 a MERN apparel storefront.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "shared",
    "server",
    "client",
    "admin"
  ],
  "scripts": {
    "dev": "concurrently -n api,shop,admin -c cyan,magenta,yellow \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:admin\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace server && npm run build --workspace client && npm run build --workspace admin",
    "seed": "npm run seed --workspace server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev:admin": "npm run dev --workspace admin",
    "smoke": "python3 tools/smoke-test.py",
    "dev:test": "npm run dev:test --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
