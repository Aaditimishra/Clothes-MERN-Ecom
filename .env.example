# Copy to .env before running the API.
#
# Every value below is validated at boot (server/src/config/env.ts). A missing or
# malformed value stops the process with a one-line message rather than failing
# later inside a request handler.

NODE_ENV=development
PORT=4000

# Local MongoDB. Any connection string works — Atlas included.
MONGODB_URI=mongodb://127.0.0.1:27017/threadline

# Must be at least 32 characters. The app REFUSES to start in production while
# this is still the development default.
JWT_SECRET=dev-only-secret-change-me-before-you-deploy
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# How long an unpaid order holds its stock, in hours.
#
# Stock is reserved the moment an order is written, so an abandoned transfer
# takes a garment off sale until something gives it back. A sweeper releases it
# after this window and marks the order failed.
PAYMENT_WINDOW_HOURS=24

# ---------------------------------------------------------------------------
# Razorpay — OPTIONAL. Leave blank and the shop takes UPI and bank transfers
# that a human confirms, which is what a shop without a gateway account does.
#
# These are environment secrets rather than settings rows on purpose: an admin
# session must never be able to read the key that can move money. Setting them
# does not turn the gateway on by itself — Store settings → Features has the
# switch, and BOTH are required, so nobody can toggle their way into a checkout
# with no credentials behind it.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Signs the webhook body. Distinct from the key secret above, because Razorpay
# signs webhooks with its own value — and an unverified webhook endpoint is an
# open door that marks any order paid on request.
#
# Without it the shop still works, but confirmation depends on the shopper's
# browser returning from the gateway: someone who pays and closes the tab
# leaves an order that has to be confirmed by hand.
RAZORPAY_WEBHOOK_SECRET=
